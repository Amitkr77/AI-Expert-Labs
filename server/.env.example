# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (your frontend URL(s)).
# Use * to allow all origins (not recommended for production).
FRONTEND_URL=https://aixpertslabs.com

# ── MongoDB ────────────────────────────────────────────
# Paste your MongoDB Atlas (or self-hosted) connection string here.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/aixperts?retryWrites=true&w=majority
MONGODB_URI=

# ── Email (Nodemailer / SMTP) ─────────────────────────────
# Works with Gmail (use an App Password, not your normal password),
# Outlook, Zoho Mail, SendGrid SMTP, or any standard SMTP provider.
#
# NOTE: some hosts (Render's free tier included) block outbound SMTP
# connections to providers like Gmail, causing "Connection timeout" even
# with correct credentials. This worked locally but may not work once
# deployed — test after deploying, and if it times out, that's a host
# network restriction, not a credentials issue.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The "From" address shown on outgoing emails (defaults to SMTP_USER if blank).
MAIL_FROM="AIxperts Labs" <your_email@gmail.com>

# Where new form submissions get sent (your business inbox).
MAIL_TO=

# Set to "false" to disable the auto-reply email sent to the person who filled the form.
SEND_AUTO_REPLY=true

# ── Admin ──────────────────────────────────────────────
# Required to use GET /api/submissions (view leads). Pick any random string.
ADMIN_API_KEY=
