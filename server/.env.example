# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (your frontend URL(s)).
# Use * to allow all origins (not recommended for production).
FRONTEND_URL=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────
# Paste your MongoDB Atlas (or self-hosted) connection string here.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/aixperts?retryWrites=true&w=majority
MONGODB_URI=

# ── Email (Resend) ─────────────────────────────────────
# Resend sends email over HTTPS instead of raw SMTP, which avoids the
# outbound SMTP connection timeouts some hosts (e.g. Render) hit when
# talking to providers like Gmail. Free tier: 3,000 emails/month.
#
# 1. Sign up at https://resend.com (free)
# 2. Create an API key: Dashboard → API Keys → Create API Key
# 3. Paste it below
RESEND_API_KEY=*********

# The "From" address shown on outgoing emails.
# Until you verify your own domain in Resend, you MUST use their shared
# test domain below — a custom "From" address will fail to send.
# Once you verify your domain (Resend → Domains → Add Domain), change this
# to something like "AIxperts Labs" <hello@aixpertslabs.com>
MAIL_FROM="AIxperts Labs" <onboarding@resend.dev>

# Where new form submissions get sent (your business inbox).
MAIL_TO=

# Set to "false" to disable the auto-reply email sent to the person who filled the form.
SEND_AUTO_REPLY=true

# ── Admin ──────────────────────────────────────────────
# Required to use GET /api/submissions (view leads). Pick any random string.
ADMIN_API_KEY=
